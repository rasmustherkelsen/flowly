{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/**/*.csproj"],
          "exclude": ["src/Flowly.Tool/**"]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["docs/**.md", "docs/**/toc.yml"],
        "exclude": ["docs/ai/**"]
      },
      {
        "files": ["toc.yml"]
      }
    ],
    "resource": [
      {
        "files": ["docs/assets/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Flowly",
      "_appTitle": "Flowly",
      "_enableSearch": true
    }
  }
}

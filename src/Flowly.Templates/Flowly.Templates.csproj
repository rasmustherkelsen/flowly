<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>Flowly.Templates</PackageId>
        <Description>Project templates for scaffolding Flowly-based .NET applications. Install with: dotnet new install Flowly.Templates</Description>
        <TargetFramework>net10.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <NoPackageAnalysis>true</NoPackageAnalysis>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
        <Compile Remove="content\**\*" />
    </ItemGroup>

    <Target Name="SyncSkills" BeforeTargets="BeforeBuild">
        <ItemGroup>
            <SkillFiles Include="$(MSBuildThisFileDirectory)..\..\\.claude\skills\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(SkillFiles)"
              DestinationFolder="$(MSBuildThisFileDirectory)content\flowly-skills\.claude\skills\%(RecursiveDir)"
              SkipUnchangedFiles="true" />
    </Target>

</Project>

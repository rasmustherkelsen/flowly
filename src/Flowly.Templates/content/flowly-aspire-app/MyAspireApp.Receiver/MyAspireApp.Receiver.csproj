<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!--#if (UseRabbitMQ)-->
        <PackageReference Include="Flowly.RabbitMQ" Version="1.2.0" />
        <!--#else-->
        <PackageReference Include="Flowly.AzureServiceBus" Version="1.2.0" />
        <!--#endif-->
        <PackageReference Include="Flowly.OpenTelemetry" Version="1.2.0" />
        <!--#if (UseJobTracking && UseSqlServer)-->
        <PackageReference Include="Flowly.Jobs.SqlServer" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseJobTracking && UsePostgres)-->
        <PackageReference Include="Flowly.Jobs.Postgres" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseJobTracking && UseSQLite)-->
        <PackageReference Include="Flowly.Jobs.SQLite" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseDeadLetterTracking && UseSqlServer)-->
        <PackageReference Include="Flowly.DeadLetters.SqlServer" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseDeadLetterTracking && UsePostgres)-->
        <PackageReference Include="Flowly.DeadLetters.Postgres" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseDeadLetterTracking && UseSQLite)-->
        <PackageReference Include="Flowly.DeadLetters.SQLite" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseDashboard)-->
        <PackageReference Include="Flowly.Dashboard" Version="1.2.0" />
        <!--#endif-->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyAspireApp.Messages\MyAspireApp.Messages.csproj" />
        <ProjectReference Include="..\MyAspireApp.ServiceDefaults\MyAspireApp.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>

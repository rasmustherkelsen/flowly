<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!--#if (UseRabbitMQ)-->
        <PackageReference Include="Flowly.RabbitMQ" Version="1.2.0" />
        <!--#elseif (UseAzureEventHubs)-->
        <PackageReference Include="Flowly.AzureEventHubs" Version="1.2.0" />
        <!--#else-->
        <PackageReference Include="Flowly.AzureServiceBus" Version="1.2.0" />
        <!--#endif-->
        <PackageReference Include="Flowly.OpenTelemetry" Version="1.2.0" />
        <!--#if (UseJobTracking)-->
        <PackageReference Include="Flowly.Jobs" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseStream && UseStreamCheckpointSqlServer)-->
        <PackageReference Include="Flowly.MessageStreams.SqlServer" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseStream && UseStreamCheckpointPostgres)-->
        <PackageReference Include="Flowly.MessageStreams.Postgres" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseStream && UseStreamCheckpointSQLite)-->
        <PackageReference Include="Flowly.MessageStreams.SQLite" Version="1.2.0" />
        <!--#endif-->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyAspireApp.Messages\MyAspireApp.Messages.csproj" />
        <ProjectReference Include="..\MyAspireApp.ServiceDefaults\MyAspireApp.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>

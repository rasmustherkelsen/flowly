<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AspireUseCliBundle>true</AspireUseCliBundle>
    </PropertyGroup>

    <ItemGroup>
        <!--#if (UseRabbitMQ)-->
        <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.6.4" />
        <!--#endif-->
        <!--#if (UseAzureServiceBus)-->
        <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.4" />
        <PackageReference Include="Flowly.AzureServiceBus.Aspire" Version="1.2.0" />
        <!--#endif-->
        <!--#if (UseAzureEventHubs)-->
        <PackageReference Include="Aspire.Hosting.Azure.EventHubs" Version="13.6.4" />
        <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.4" />
        <!--#endif-->
        <!--#if (NeedsSqlServerInfrastructure)-->
        <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
        <!-- Aspire.Hosting.SqlServer still pulls System.Security.Cryptography.Pkcs 10.0.12 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx); remove once Aspire ships the fix. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
        <!--#endif-->
        <!--#if (NeedsPostgresInfrastructure)-->
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
        <!--#endif-->
    </ItemGroup>

    <ItemGroup>
        <!--#if (!UseInMemory)-->
        <ProjectReference Include="..\MyAspireApp.Sender\MyAspireApp.Sender.csproj" />
        <ProjectReference Include="..\MyAspireApp.Receiver\MyAspireApp.Receiver.csproj" />
        <!--#if (UseJobTracking)-->
        <ProjectReference Include="..\MyAspireApp.JobTracker\MyAspireApp.JobTracker.csproj" />
        <!--#endif-->
        <!--#if (UseDeadLetterTracking)-->
        <ProjectReference Include="..\MyAspireApp.DeadLetterTracker\MyAspireApp.DeadLetterTracker.csproj" />
        <!--#endif-->
        <!--#if (UseDashboard)-->
        <ProjectReference Include="..\MyAspireApp.Dashboard\MyAspireApp.Dashboard.csproj" />
        <!--#endif-->
        <!--#endif-->
        <!--#if (UseInMemory)-->
        <ProjectReference Include="..\MyAspireApp.App\MyAspireApp.App.csproj" />
        <!--#endif-->
    </ItemGroup>

</Project>

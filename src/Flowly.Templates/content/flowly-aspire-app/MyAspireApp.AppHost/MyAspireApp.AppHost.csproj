<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AspireUseCliBundle>true</AspireUseCliBundle>
    </PropertyGroup>

    <ItemGroup>
        <!-- Aspire.Hosting still pulls MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h); remove once Aspire ships the fix. -->
        <PackageReference Include="MessagePack" Version="2.5.303" />
    </ItemGroup>

    <ItemGroup>
        <!--#if (UseRabbitMQ)-->
        <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.6.1" />
        <!--#endif-->
        <!--#if (UseAzureServiceBus)-->
        <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.1" />
        <PackageReference Include="Flowly.AzureServiceBus.Aspire" Version="1.2.0" />
        <!--#endif-->
        <!--#if (NeedsSqlServerInfrastructure)-->
        <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
        <!--#endif-->
        <!--#if (NeedsPostgresInfrastructure)-->
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
        <!--#endif-->
    </ItemGroup>

    <ItemGroup>
        <!--#if (!UseInMemory)-->
        <ProjectReference Include="..\MyAspireApp.Sender\MyAspireApp.Sender.csproj" />
        <ProjectReference Include="..\MyAspireApp.Receiver\MyAspireApp.Receiver.csproj" />
        <!--#if (UseJobTracking)-->
        <ProjectReference Include="..\MyAspireApp.JobTracker\MyAspireApp.JobTracker.csproj" />
        <!--#endif-->
        <!--#if (UseDeadLetterTracking)-->
        <ProjectReference Include="..\MyAspireApp.DeadLetterTracker\MyAspireApp.DeadLetterTracker.csproj" />
        <!--#endif-->
        <!--#if (UseDashboard)-->
        <ProjectReference Include="..\MyAspireApp.Dashboard\MyAspireApp.Dashboard.csproj" />
        <!--#endif-->
        <!--#endif-->
        <!--#if (UseInMemory)-->
        <ProjectReference Include="..\MyAspireApp.App\MyAspireApp.App.csproj" />
        <!--#endif-->
    </ItemGroup>

</Project>

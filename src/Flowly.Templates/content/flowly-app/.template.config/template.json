{
  "$schema": "http://json.schemastore.org/template",
  "author": "Rasmus Therkelsen",
  "classifications": [ "Flowly", "Messaging", "Solution", "Quickstart" ],
  "identity": "Flowly.App.1.0",
  "name": "Flowly App",
  "shortName": "flowlyapp",
  "description": "A complete Flowly send/receive solution — Messages library, Sender, and Receiver pre-wired for your chosen transport.",
  "sourceName": "MyFlowlyApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "transport": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": true,
      "displayName": "Transport",
      "description": "The messaging transport to use. Required.",
      "choices": [
        { "choice": "rabbitmq",        "description": "RabbitMQ transport." },
        { "choice": "rmq",             "description": "Alias for rabbitmq." },
        { "choice": "azureservicebus", "description": "Azure Service Bus transport." },
        { "choice": "asb",             "description": "Alias for azureservicebus." },
        { "choice": "inmemory",        "description": "In-memory transport (no broker required)." },
        { "choice": "inm",             "description": "Alias for inmemory." }
      ]
    },
    "UseRabbitMQ": {
      "type": "computed",
      "value": "(transport == \"rabbitmq\" || transport == \"rmq\")"
    },
    "UseAzureServiceBus": {
      "type": "computed",
      "value": "(transport == \"azureservicebus\" || transport == \"asb\")"
    },
    "UseInMemory": {
      "type": "computed",
      "value": "(transport == \"inmemory\" || transport == \"inm\")"
    },
    "HasTransportConnectionString": {
      "type": "computed",
      "value": "(UseRabbitMQ || UseAzureServiceBus)"
    },
    "jobtracking": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Job tracking",
      "description": "Add Flowly job state tracking. Requires --db sqlserver|postgres|sqlite."
    },
    "jobs": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Alias for --jobtracking."
    },
    "UseJobTracking": {
      "type": "computed",
      "value": "(jobtracking || jobs)"
    },
    "deadlettertracking": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Dead-letter tracking",
      "description": "Add Flowly dead-letter tracking. Requires --db sqlserver|postgres|sqlite."
    },
    "deadletter": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Alias for --deadlettertracking."
    },
    "UseDeadLetterTracking": {
      "type": "computed",
      "value": "(deadlettertracking || deadletter)"
    },
    "callhandler": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Call handler (RPC)",
      "description": "Scaffold the main message as an RPC-style call/response pair using CallHandler and IMessageCaller instead of the default fire-and-forget MessageHandler."
    },
    "call": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Alias for --callhandler."
    },
    "UseCallHandler": {
      "type": "computed",
      "value": "(callhandler || call)"
    },
    "streamhandler": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Stream handler",
      "description": "Scaffold the main message as an append-only, replayable stream using MessageStreamHandler<T> and IMessageRecorder instead of the default fire-and-forget MessageHandler. RabbitMQ or InMemory only; incompatible with --call.",
      "isEnabled": "(!callhandler && !call && transport != \"azureservicebus\" && transport != \"asb\")"
    },
    "stream": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Alias for --streamhandler.",
      "isEnabled": "(!callhandler && !call && transport != \"azureservicebus\" && transport != \"asb\")"
    },
    "UseStream": {
      "type": "computed",
      "value": "(streamhandler || stream)"
    },
    "partitions": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "0",
      "displayName": "Stream partitions",
      "description": "Number of partitions for the stream via [StreamPartitions(n)] on the message contract. 0 (default) = non-partitioned. Requires --stream.",
      "replaces": "424242"
    },
    "UseStreamPartitions": {
      "type": "computed",
      "value": "(partitions > 0)"
    },
    "UseRabbitMqStreamPartitions": {
      "type": "computed",
      "value": "(UseRabbitMQ && UseStreamPartitions)"
    },
    "UseDatabase": {
      "type": "computed",
      "value": "(UseJobTracking || UseDeadLetterTracking)"
    },
    "db": {
      "type": "parameter",
      "datatype": "choice",
      "isEnabled": "(jobtracking || jobs || deadlettertracking || deadletter)",
      "isRequired": true,
      "defaultValue": "sqlserver",
      "displayName": "Database backend",
      "description": "Database backend for job tracking and/or dead-letter tracking. Required when --jobs or --deadletter is used.",
      "choices": [
        { "choice": "sqlserver", "description": "SQL Server" },
        { "choice": "postgres",  "description": "PostgreSQL" },
        { "choice": "sqlite",    "description": "SQLite" }
      ]
    },
    "UseSqlServer": {
      "type": "computed",
      "value": "db == \"sqlserver\""
    },
    "UsePostgres": {
      "type": "computed",
      "value": "db == \"postgres\""
    },
    "UseSQLite": {
      "type": "computed",
      "value": "db == \"sqlite\""
    },
    "dashboard": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Dashboard",
      "description": "Scaffold a standalone Dashboard project hosting the Flowly management UI at /. For InMemory transport the dashboard is embedded in App instead."
    },
    "UseDashboard": {
      "type": "computed",
      "value": "dashboard"
    },
    "opentelemetry": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "OpenTelemetry",
      "description": "Add Flowly.OpenTelemetry and wire up metrics and tracing."
    },
    "otel": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Alias for --opentelemetry."
    },
    "otel-export": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "none",
      "displayName": "OpenTelemetry export",
      "description": "Add an exporter. 'default' wires OTLP gated on OTEL_EXPORTER_OTLP_ENDPOINT; 'jaeger' wires OTLP unconditionally and adds a Jaeger container to docker-compose; 'zipkin' wires Zipkin and adds a Zipkin container. Implies --otel.",
      "choices": [
        { "choice": "none",    "description": "No exporter." },
        { "choice": "default", "description": "OTLP export, gated on OTEL_EXPORTER_OTLP_ENDPOINT env var." },
        { "choice": "jaeger",  "description": "OTLP export to a local Jaeger container." },
        { "choice": "zipkin",  "description": "Zipkin export to a local Zipkin container." }
      ]
    },
    "oe": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "none",
      "description": "Alias for --otel-export.",
      "choices": [
        { "choice": "none",    "description": "No exporter." },
        { "choice": "default", "description": "OTLP export, gated on OTEL_EXPORTER_OTLP_ENDPOINT env var." },
        { "choice": "jaeger",  "description": "OTLP export to a local Jaeger container." },
        { "choice": "zipkin",  "description": "Zipkin export to a local Zipkin container." }
      ]
    },
    "UseOtelExportDefault": {
      "type": "computed",
      "value": "(otel-export == \"default\" || oe == \"default\")"
    },
    "UseOtelExportJaeger": {
      "type": "computed",
      "value": "(otel-export == \"jaeger\" || oe == \"jaeger\")"
    },
    "UseOtelExportZipkin": {
      "type": "computed",
      "value": "(otel-export == \"zipkin\" || oe == \"zipkin\")"
    },
    "UseOtelExport": {
      "type": "computed",
      "value": "(UseOtelExportDefault || UseOtelExportJaeger || UseOtelExportZipkin)"
    },
    "UseOpenTelemetry": {
      "type": "computed",
      "value": "(opentelemetry || otel || UseOtelExport)"
    },
    "NeedsSqlServerInfrastructure": {
      "type": "computed",
      "value": "(UseDatabase && UseSqlServer)"
    },
    "NeedsPostgresInfrastructure": {
      "type": "computed",
      "value": "(UseDatabase && UsePostgres)"
    },
    "JobsIsFirstEntry": {
      "type": "computed",
      "value": "(UseJobTracking && !HasTransportConnectionString)"
    },
    "JobsIsSubsequentEntry": {
      "type": "computed",
      "value": "(UseJobTracking && HasTransportConnectionString)"
    },
    "DeadLettersIsFirstEntry": {
      "type": "computed",
      "value": "(UseDeadLetterTracking && !HasTransportConnectionString && !UseJobTracking)"
    },
    "DeadLettersIsSubsequentEntry": {
      "type": "computed",
      "value": "(UseDeadLetterTracking && (HasTransportConnectionString || UseJobTracking))"
    },
    "HttpPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "5195",
      "parameters": {
        "low": 5000,
        "high": 5300
      }
    },
    "HttpsPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "7176",
      "parameters": {
        "low": 7000,
        "high": 7300
      }
    },
    "DashboardHttpPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "5080",
      "parameters": {
        "low": 5000,
        "high": 5300
      }
    },
    "DashboardHttpsPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "7080",
      "parameters": {
        "low": 7000,
        "high": 7300
      }
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(UseRabbitMQ)",
          "rename": { "docker-compose-rabbitmq.yml": "docker-compose.yml" },
          "exclude": [ "docker-compose-asb.yml", "sbconfig.json", "App/**", "MyFlowlyApp-single.slnx" ]
        },
        {
          "condition": "(UseAzureServiceBus)",
          "rename": { "docker-compose-asb.yml": "docker-compose.yml" },
          "exclude": [ "docker-compose-rabbitmq.yml", "App/**", "MyFlowlyApp-single.slnx" ]
        },
        {
          "condition": "(UseInMemory)",
          "rename": { "MyFlowlyApp-single.slnx": "MyFlowlyApp.slnx" },
          "exclude": [ "MyFlowlyApp.slnx", "docker-compose-rabbitmq.yml", "docker-compose-asb.yml", "sbconfig.json", "Messages/**", "Sender/**", "Receiver/**", "JobTracker/**", "DeadLetterTracker/**", "Dashboard/**" ]
        },
        {
          "condition": "(!UseJobTracking)",
          "exclude": [
            "JobTracker/**",
            "Messages/ProcessJobMessage.cs",
            "Receiver/Handlers/ProcessJobHandler.cs",
            "Sender/Services/JobSubmitterService.cs",
            "App/Messages/ProcessJobMessage.cs",
            "App/Handlers/ProcessJobHandler.cs",
            "App/Services/JobSubmitterService.cs"
          ]
        },
        {
          "condition": "(!UseDeadLetterTracking)",
          "exclude": [
            "DeadLetterTracker/**",
            "Messages/DeadLetterSampleMessage.cs",
            "Receiver/Handlers/DeadLetterSampleMessageHandler.cs",
            "Sender/Services/FailingMessageSenderService.cs",
            "App/Messages/DeadLetterSampleMessage.cs",
            "App/Handlers/DeadLetterSampleMessageHandler.cs",
            "App/Services/FailingMessageSenderService.cs"
          ]
        },
        {
          "condition": "(!UseDashboard)",
          "exclude": [ "Dashboard/**" ]
        },
        {
          "condition": "(!UseRabbitMqStreamPartitions)",
          "exclude": [ "enabled_plugins", "rabbitmq.conf" ]
        }
      ]
    }
  ],
  "specialCustomOperations": {
    "**/*.csproj": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif-->" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    },
    "**/*.json": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "//#if" ],
            "else": [ "//#else" ],
            "elseif": [ "//#elseif" ],
            "endif": [ "//#endif" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    },
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif-->" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    },
    "**/*.yml": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "#if" ],
            "else": [ "#else" ],
            "elseif": [ "#elseif" ],
            "endif": [ "#endif" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  },
  "primaryOutputs": [
    {
      "path": "MyFlowlyApp.slnx"
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "description": "Restore NuGet packages",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true,
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ]
    }
  ]
}

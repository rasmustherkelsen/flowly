{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
//#if (!NoHttp)
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5195",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
        //#if (UseOtelExportJaeger)
        , "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
        //#endif
        //#if (UseOtelExport)
        , "OTEL_SERVICE_NAME": "FlowlyApp"
        //#endif
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7176;http://localhost:5195",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
        //#if (UseOtelExportJaeger)
        , "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
        //#endif
        //#if (UseOtelExport)
        , "OTEL_SERVICE_NAME": "FlowlyApp"
        //#endif
      }
    }
//#else
    "run": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
        //#if (UseOtelExportJaeger)
        , "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
        //#endif
        //#if (UseOtelExport)
        , "OTEL_SERVICE_NAME": "FlowlyApp"
        //#endif
      }
    }
//#endif
  }
}

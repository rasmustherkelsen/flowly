{
  "$schema": "http://json.schemastore.org/template",
  "author": "Rasmus Therkelsen",
  "classifications": [ "Flowly", "Messaging", "Web", "ASP.NET Core" ],
  "identity": "Flowly.Project.1.0",
  "name": "Flowly Project",
  "shortName": "flowly",
  "description": "An ASP.NET Core Web API project pre-wired with Flowly messaging.",
  "sourceName": "FlowlyApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "transport": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": true,
      "displayName": "Transport",
      "description": "The messaging transport to use. Required.",
      "choices": [
        { "choice": "rabbitmq",        "description": "RabbitMQ transport." },
        { "choice": "rmq",             "description": "Alias for rabbitmq." },
        { "choice": "azureservicebus", "description": "Azure Service Bus transport." },
        { "choice": "asb",             "description": "Alias for azureservicebus." },
        { "choice": "inmemory",        "description": "In-memory transport (no broker required)." },
        { "choice": "inm",             "description": "Alias for inmemory." }
      ]
    },
    "UseRabbitMQ": {
      "type": "computed",
      "value": "(transport == \"rabbitmq\" || transport == \"rmq\")"
    },
    "UseAzureServiceBus": {
      "type": "computed",
      "value": "(transport == \"azureservicebus\" || transport == \"asb\")"
    },
    "UseInMemory": {
      "type": "computed",
      "value": "(transport == \"inmemory\" || transport == \"inm\")"
    },
    "HasTransport": {
      "type": "computed",
      "value": "(UseRabbitMQ || UseAzureServiceBus || UseInMemory)"
    },
    "HasTransportConnectionString": {
      "type": "computed",
      "value": "(UseRabbitMQ || UseAzureServiceBus)"
    },
    "jobtracking": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Job tracking",
      "description": "Add Flowly job state tracking. Requires --db sqlserver|postgres|sqlite."
    },
    "jobs": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Alias for --jobtracking."
    },
    "UseJobTracking": {
      "type": "computed",
      "value": "(jobtracking || jobs)"
    },
    "deadlettertracking": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Dead-letter tracking",
      "description": "Add Flowly dead-letter tracking. Requires --db sqlserver|postgres|sqlite."
    },
    "deadletter": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Alias for --deadlettertracking."
    },
    "UseDeadLetterTracking": {
      "type": "computed",
      "value": "(deadlettertracking || deadletter)"
    },
    "UseDatabase": {
      "type": "computed",
      "value": "(UseJobTracking || UseDeadLetterTracking)"
    },
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "isEnabled": "(jobtracking || jobs || deadlettertracking || deadletter)",
      "defaultValue": "unset",
      "displayName": "Database backend",
      "description": "Database backend for job tracking and/or dead-letter tracking. Long form of --db.",
      "choices": [
        { "choice": "sqlserver", "description": "SQL Server" },
        { "choice": "postgres",  "description": "PostgreSQL" },
        { "choice": "sqlite",    "description": "SQLite" },
        { "choice": "unset",     "description": "Not specified (use --db instead)." }
      ]
    },
    "db": {
      "type": "parameter",
      "datatype": "choice",
      "isEnabled": "(jobtracking || jobs || deadlettertracking || deadletter) && database == \"unset\"",
      "isRequired": true,
      "defaultValue": "sqlserver",
      "displayName": "Database backend (short form)",
      "description": "Database backend for job tracking and/or dead-letter tracking. Short form of --database. Required when --jobs or --deadletter is used and --database is not specified.",
      "choices": [
        { "choice": "sqlserver", "description": "SQL Server" },
        { "choice": "postgres",  "description": "PostgreSQL" },
        { "choice": "sqlite",    "description": "SQLite" }
      ]
    },
    "UseSqlServer": {
      "type": "computed",
      "value": "((database == \"sqlserver\") || (database == \"unset\" && db == \"sqlserver\"))"
    },
    "UsePostgres": {
      "type": "computed",
      "value": "((database == \"postgres\") || (database == \"unset\" && db == \"postgres\"))"
    },
    "UseSQLite": {
      "type": "computed",
      "value": "((database == \"sqlite\") || (database == \"unset\" && db == \"sqlite\"))"
    },
    "opentelemetry": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "OpenTelemetry",
      "description": "Add Flowly.OpenTelemetry and wire up metrics and tracing."
    },
    "otel": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Alias for --opentelemetry."
    },
    "UseOpenTelemetry": {
      "type": "computed",
      "value": "(opentelemetry || otel)"
    },
    "inline": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Inline configuration",
      "description": "Wire up Flowly inline in Program.cs instead of a dedicated FlowlyConfiguration class."
    },
    "UseInline": {
      "type": "computed",
      "value": "inline"
    },
    "JobsIsFirstEntry": {
      "type": "computed",
      "value": "(UseJobTracking && !HasTransportConnectionString)"
    },
    "JobsIsSubsequentEntry": {
      "type": "computed",
      "value": "(UseJobTracking && HasTransportConnectionString)"
    },
    "DeadLettersIsFirstEntry": {
      "type": "computed",
      "value": "(UseDeadLetterTracking && !HasTransportConnectionString && !UseJobTracking)"
    },
    "DeadLettersIsSubsequentEntry": {
      "type": "computed",
      "value": "(UseDeadLetterTracking && (HasTransportConnectionString || UseJobTracking))"
    },
    "no-http": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "No HTTP",
      "description": "Configure as a worker service with no HTTP listener. Use for projects that only process queue messages."
    },
    "NoHttp": {
      "type": "computed",
      "value": "no-http"
    },
    "HttpPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "5195",
      "parameters": {
        "low": 5000,
        "high": 5300
      }
    },
    "HttpsPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "7176",
      "parameters": {
        "low": 7000,
        "high": 7300
      }
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(UseInline)",
          "exclude": [ "FlowlyConfiguration.cs" ]
        }
      ]
    }
  ],
  "specialCustomOperations": {
    "**/*.csproj": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif-->" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    },
    "**/*.json": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "//#if" ],
            "else": [ "//#else" ],
            "elseif": [ "//#elseif" ],
            "endif": [ "//#endif" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  },
  "primaryOutputs": [
    {
      "path": "FlowlyApp.csproj"
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "description": "Restore NuGet packages",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true,
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ]
    }
  ]
}

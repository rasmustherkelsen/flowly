<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Flowly.ManagementApi</PackageId>
        <Description>Opt-in operational HTTP surface for Flowly — a minimal, machine-oriented management API (no UI), independent of Flowly.Dashboard. Ships message stream checkpoint list/reset and message stream partition list/resume (halted partitions); new features register additional IFlowlyManagementAction implementations.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flowly\Flowly.csproj" />
        <!-- Referenced only for its checkpoint list/reset actions, feature-detected at UseFlowlyManagementApi() time — not a hard dependency for callers who never configure message stream persistence. -->
        <ProjectReference Include="..\Flowly.MessageStreams\Flowly.MessageStreams.csproj" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Flowly.ManagementApi.Tests" />
    </ItemGroup>

</Project>
